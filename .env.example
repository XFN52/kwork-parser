# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_IDS=123456789,987654321

# Parser settings
POLL_INTERVAL_SECONDS=60
POLL_JITTER_SECONDS=15
LOG_LEVEL=INFO

# Storage
DATABASE_PATH=data/kwork_parser.db
LOG_FILE=logs/kwork_parser.log

# Optional Proxy: http://user:pass@host:port or socks5://host:port
# PROXY=http://1.2.3.4:8080

# Filter Overrides (optional)
# FILTER_CATEGORIES=11
# FILTER_KEYWORDS=python,парсер,бот,скрипт
# FILTER_STOP_WORDS=1с,диплом
# FILTER_MIN_PRICE=1000
# FILTER_MAX_PRICE=100000
# FILTER_MAX_OFFERS=10

# AI Proposal Generator (OpenAI / OpenRouter / DeepSeek / Ollama)
AI_ENABLED=true
AI_API_KEY=
# AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=gpt-4o-mini
AI_CONTEXT_FILE=config/portfolio.md

# Profi.ru Monitor (https://profi.ru/backoffice/n.php)
PROFI_ENABLED=false
# PROFI_COOKIES="p_uid=...; session_id=..."
# PROFI_URL=https://profi.ru/backoffice/n.php

